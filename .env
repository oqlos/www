# ═══════════════════════════════════════════════════════════════
# OqlOS Portal Configuration
# Single source of truth for all environment variables
# ═══════════════════════════════════════════════════════════════

# ─── Application ───
VITE_APP_NAME=OqlOS
VITE_APP_VERSION=0.1.1
VITE_APP_COPYRIGHT=2024-2026

# ─── Server Ports ───
VITE_DEV_PORT=3000
VITE_NGINX_PORT=80
VITE_API_PORT=8101
VITE_TRAEFIK_PORT=8080
VITE_OQLAGENT_PORT=8200

# ─── API URLs ───
VITE_BACKEND_URL=http://localhost:8101
VITE_API_URL=http://localhost:8101
VITE_API_WS_URL=wss://api.oqlos.io/ws/agent
VITE_API_DEV_URL=http://api.oqlos.localhost
VITE_IDE_DEV_URL=http://ide.oqlos.localhost
VITE_TRAEFIK_DEV_URL=http://localhost:8080

# ─── Docker Domains ───
DOCKER_DOMAIN_PORTAL=oqlos.localhost
DOCKER_DOMAIN_TRAEFIK=traefik.oqlos.localhost
DOCKER_DOMAIN_MAILPIT=mail.oqlos.localhost
DOCKER_DOMAIN_CQL=cql.localhost

# ─── External Services ───
VITE_DOMAIN_CQL=cql.localhost

# ─── Docker ───
VITE_DOCKER_IMAGE=ghcr.io/softreck/oqlagent:latest
VITE_DOCKER_BACKEND_SERVICE=oqlapi

# ─── GitHub ───
VITE_GITHUB_REPO=https://github.com/softreck/oqlos
VITE_GITHUB_ORG=softreck
VITE_GITHUB_REPO_NAME=oqlos

# ─── Hardware ───
VITE_HARDWARE_MODE=real
VITE_MODBUS_SERIAL_PORT=/dev/ttyACM1
VITE_I2C_BUS=/dev/i2c-1
VITE_USB_DEVICE=/dev/ttyACM0

# ─── Deployment ───
VITE_DEPLOY_DIR=/opt/oqlos/www
VITE_SERVICE_NAME=oqlos-portal
VITE_SERVICE_USER=www-data
VITE_SERVICE_GROUP=www-data

# ─── Testing ───
VITE_TEST_URL=http://localhost:3000
VITE_TEST_TIMEOUT=60

# ─── Demo User ───
VITE_DEMO_USER_EMAIL=demo@oqlos.com
VITE_DEMO_USER_PASSWORD=demo123
VITE_DEMO_USER_NAME="Demo User"
VITE_DEMO_USER_ROLE=user

# ─── Fonts ───
VITE_FONTS_URL=https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Sora:wght@300;400;600;700;800&display=swap

# ─── Logging ───
VITE_LOG_LEVEL=info
VITE_LOG_TO_FILE=false
VITE_LOG_TO_DB=false
VITE_LOG_FILE_PATH=./logs/oqlos-portal.log
VITE_SQLITE_DB_PATH=./logs/oqlos-portal.db
VITE_LOG_MAX_SIZE=10485760
VITE_LOG_MAX_FILES=5

# ═══════════════════════════════════════════════════════════════
# Mock API Configuration (Development Mode)
# ═══════════════════════════════════════════════════════════════

# Global mock switch - when true, all endpoints below use mocks unless overridden
VITE_FORCE_MOCK_API=false

# Individual mock controls (override global when VITE_FORCE_MOCK_API is not set)
# Set to "true" to mock specific endpoints, "false" to use real backend
VITE_MOCK_AUTH=false         # /auth/* endpoints (login, verify)
VITE_MOCK_USER_API=false     # /api/user* endpoints
VITE_MOCK_SCENARIOS=false    # /api/scenarios endpoints
VITE_MOCK_BILLING=false     # /billing/* endpoints
VITE_MOCK_NLP=false          # /nlp/* endpoints (LLM - requires real backend)
VITE_MOCK_INTEGRATIONS=false # /integrations/* endpoints (Slack)

# ═══════════════════════════════════════════════════════════════
# pfix Configuration (Self-healing Python)
# ═══════════════════════════════════════════════════════════════

# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=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

# Default AI model for cost analysis
#LLM_MODEL=openrouter/qwen/qwen3-coder-next
LLM_MODEL=openrouter/x-ai/grok-code-fast-1

# Behavior
PFIX_AUTO_APPLY=true         # true = apply fixes without asking
PFIX_AUTO_INSTALL_DEPS=true   # true = auto pip/uv install
PFIX_AUTO_RESTART=false        # true = os.execv restart after fix
PFIX_MAX_RETRIES=3
PFIX_DRY_RUN=false
PFIX_ENABLED=true

# Git integration
PFIX_GIT_COMMIT=false         # true = auto-commit fixes
PFIX_GIT_PREFIX=pfix:         # commit message prefix

# Backup
PFIX_CREATE_BACKUPS=false     # false = disable .pfix_backups/ directory
