{
  "name": "oqlos-portal",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0 || echo 'ESLint not configured'",
    "test:unit": "echo 'No unit tests configured - add vitest/jest'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "bash test.sh",
    "ansible:test": "ansible-playbook -i ansible/inventory.ini ansible/playbook-test.yml",
    "ansible:deploy": "ansible-playbook -i ansible/inventory.ini ansible/playbook-deploy.yml"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  },
  "author": {
    "name": "Tom Sapletta",
    "email": "tom@sapletta.com"
  }
}
