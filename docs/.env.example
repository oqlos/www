# OqlOS Production Environment Template
# Copy to .env.prod and fill in values

# ============================================
# Database Configuration
# ============================================
DB_USER=oqlos_prod
DB_PASS=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# ============================================
# Redis Configuration
# ============================================
REDIS_PASS=CHANGE_ME_REDIS_PASSWORD_32_CHARS

# ============================================
# Security & Secrets
# ============================================
# Generate: openssl rand -base64 32
SECRET_KEY=YOUR_SECRET_KEY_HERE

# Let's Encrypt email for SSL certificates
ACME_EMAIL=admin@oqlos.com

# ============================================
# TLS / SSL Certificate Configuration
# ============================================
# Domains for SSL certificates (comma-separated)
# These must match your DNS A records pointing to this server
TRAEFIK_DOMAINS=oqlos.com,www.oqlos.com,api.oqlos.com,docs.oqlos.com

# Let's Encrypt CA Server
# Production: https://acme-v02.api.letsencrypt.org/directory (default)
# Staging (for testing): https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Certificate resolvers (separate with spaces)
# Use "letsencrypt" for production or "staging" for testing
TRAEFIK_CERT_RESOLVERS=letsencrypt

# Traefik dashboard credentials (optional, base64 encoded user:pass)
# Generate: echo $(htpasswd -nB user) | sed -e s/\$/\$\$/g
# TRAEFIK_DASHBOARD_AUTH=user:$$2y$$10$$...

# ============================================
# Payment Providers (PRODUCTION KEYS!)
# ============================================
# Stripe - Get from https://dashboard.stripe.com/apikeys
STRIPE_SK=sk_live_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# Przelewy24 (Polish payments) - https://panel.przelewy24.pl
P24_MID=XXXXXX
P24_CRC=XXXXXXXXXXXXXXXX

# ============================================
# Email/SMTP Configuration
# ============================================
SMTP_HOST=smtp.oqlos.com
SMTP_PORT=587
SMTP_USER=noreply@oqlos.com
SMTP_PASS=YOUR_SMTP_PASSWORD

# ============================================
# Deployment Configuration
# ============================================
# Docker image version (git tag or 'latest')
VERSION=v1.0.0

# Backend API URL (for CORS)
BACKEND_URL=https://api.oqlos.com

# ============================================
# Optional: Monitoring & Analytics
# ============================================
# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# Google Analytics
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
