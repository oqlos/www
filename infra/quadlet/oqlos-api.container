[Unit]
Description=OqlOS API (FastAPI backend)
After=oqlos-traefik.service
Requires=oqlos-traefik.service

[Container]
Image=ghcr.io/softreck/oqlapi:latest
ContainerName=oqlos-api
Network=oqlos.network
Environment=OQLOS_ENV=prod
Environment=OQLOS_HARDWARE_MODE=mock
Volume=oqlos-api-data:/data
Label=traefik.enable=true
Label=traefik.http.routers.api.rule=Host(`api.oqlos.com`)
Label=traefik.http.routers.api.entrypoints=websecure
Label=traefik.http.routers.api.tls.certresolver=le
Label=traefik.http.services.api.loadbalancer.server.port=8101

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
