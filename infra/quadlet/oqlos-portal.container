[Unit]
Description=OqlOS Web Portal (React + Nginx)
After=oqlos-api.service
Requires=oqlos-api.service

[Container]
Image=ghcr.io/softreck/oqlos-portal:latest
ContainerName=oqlos-portal
Network=oqlos.network
Environment=NGINX_PORT=80
Environment=BACKEND_URL=http://oqlos-api:8101
Label=traefik.enable=true
Label=traefik.http.routers.portal.rule=Host(`oqlos.com`) || Host(`www.oqlos.com`)
Label=traefik.http.routers.portal.entrypoints=websecure
Label=traefik.http.routers.portal.tls.certresolver=le
Label=traefik.http.services.portal.loadbalancer.server.port=80

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
